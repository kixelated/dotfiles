[Unit]
Description=Retire inactive agent worktrees and collect MBX build storage

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/clean.sh --gc --root %h/work --root %h/.codex/worktrees
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
