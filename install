#!/bin/bash
set -euxo pipefail

DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )

rm -f ~/.vimrc && ln -s "$DIR/vimrc" ~/.vimrc
# Shared shell configuration used by the Bash and Zsh entrypoints.
rm -f ~/.kixelated.shellenv ~/.kixelated.shellrc
ln -s "$DIR/shellenv" ~/.kixelated.shellenv
ln -s "$DIR/shellrc" ~/.kixelated.shellrc

# The machine's ~/.bashrc stays local; it just sources the tracked config.
rm -f ~/.kixelated.bashrc && ln -s "$DIR/bashrc" ~/.kixelated.bashrc
grep -qsF 'source ~/.kixelated.bashrc' ~/.bashrc || echo 'source ~/.kixelated.bashrc' >> ~/.bashrc

# The machine's ~/.zshrc stays local; it just sources the tracked config.
rm -f ~/.kixelated.zshrc && ln -s "$DIR/zshrc" ~/.kixelated.zshrc
grep -qsF 'source ~/.kixelated.zshrc' ~/.zshrc || echo 'source ~/.kixelated.zshrc' >> ~/.zshrc

rm -f ~/.zshenv && ln -s "$DIR/zshenv" ~/.zshenv

# ~/.local/bin is already on PATH via shellenv, so everything in bin/ becomes a
# command by being linked there.
mkdir -p ~/.local/bin
for f in "$DIR"/bin/*; do
	rm -f ~/.local/bin/"$(basename "$f")" && ln -s "$f" ~/.local/bin/"$(basename "$f")"
done
mkdir -p ~/.cargo && rm -f ~/.cargo/config.toml && ln -s "$DIR/cargo/config.toml" ~/.cargo/config.toml
mkdir -p ~/.config/mise
rm -f ~/.config/mise/config.toml && ln -s "$DIR/mise/config.toml" ~/.config/mise/config.toml
mkdir -p ~/.config/opencode
rm -f ~/.config/opencode/opencode.jsonc && ln -s "$DIR/opencode/opencode.jsonc" ~/.config/opencode/opencode.jsonc

# mise follows mbx's rapid releases while the tracked wrapper keeps plain Cargo
# routed through it. setup also installs the shim used outside mise activation.
command -v mise >/dev/null
mise install mr-boxington
mise exec -- mbx setup --global
mise exec -- mbx setup --global --status

# ~/.agents/skills is Codex's user-level skills dir; ~/.codex/skills is
# deprecated and Codex-managed (.system lives there), so leave it alone.
# Skills live in .claude/skills; .agents/skills links to the same directory.
mkdir -p ~/.claude ~/.codex ~/.agents
rm -rf ~/.claude/skills ~/.agents/skills
rm -f ~/.claude/CLAUDE.md ~/.codex/AGENTS.md
ln -s "$DIR/.claude/CLAUDE.md" ~/.claude/CLAUDE.md
ln -s "$DIR/.claude/skills" ~/.claude/skills
ln -s "$DIR/.claude/CLAUDE.md" ~/.codex/AGENTS.md
ln -s "$DIR/.claude/skills" ~/.agents/skills

# Repositories can explicitly opt into this loader through their trusted
# .codex/config.toml and a reviewed hook that captures the environment.
rm -f ~/.codex/bash-env.sh
ln -s "$DIR/codex/bash-env.sh" ~/.codex/bash-env.sh

git submodule update --init --remote
