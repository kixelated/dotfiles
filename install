#!/usr/bin/env bash
set -euxo pipefail

DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

rm -f ~/.vimrc && ln -s "$DIR/vimrc" ~/.vimrc
# Shared shell configuration used by the Bash and Zsh entrypoints.
rm -f ~/.kixelated.shellenv ~/.kixelated.shellrc
ln -s "$DIR/shellenv" ~/.kixelated.shellenv
ln -s "$DIR/shellrc" ~/.kixelated.shellrc

# The machine's ~/.bashrc stays local; it just sources the tracked config.
rm -f ~/.kixelated.bashrc && ln -s "$DIR/bashrc" ~/.kixelated.bashrc
grep -qsF 'source ~/.kixelated.bashrc' ~/.bashrc || echo 'source ~/.kixelated.bashrc' >>~/.bashrc

# The machine's ~/.zshrc stays local; it just sources the tracked config.
rm -f ~/.kixelated.zshrc && ln -s "$DIR/zshrc" ~/.kixelated.zshrc
grep -qsF 'source ~/.kixelated.zshrc' ~/.zshrc || echo 'source ~/.kixelated.zshrc' >>~/.zshrc

rm -f ~/.zshenv && ln -s "$DIR/zshenv" ~/.zshenv

# ~/.local/bin is already on PATH via shellenv, so everything in bin/ becomes a
# command by being linked there.
mkdir -p ~/.local/bin
for f in "$DIR"/bin/*; do
	[ -f "$f" ] || continue
	rm -f ~/.local/bin/"$(basename "$f")" && ln -s "$f" ~/.local/bin/"$(basename "$f")"
done
mkdir -p ~/.cargo && rm -f ~/.cargo/config.toml && ln -s "$DIR/cargo/config.toml" ~/.cargo/config.toml
mkdir -p ~/.config/mise
rm -f ~/.config/mise/config.toml && ln -s "$DIR/mise/config.toml" ~/.config/mise/config.toml
# mbx reads its config from the platform config dir, not always ~/.config.
if [ "$(uname -s)" = Darwin ]; then
	mbx_dir=~/Library/"Application Support"/mbx
else
	mbx_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mbx"
fi
mkdir -p "$mbx_dir"
rm -f "$mbx_dir/config.toml" && ln -s "$DIR/mbx/config.toml" "$mbx_dir/config.toml"
mkdir -p ~/.config/opencode
rm -f ~/.config/opencode/opencode.jsonc && ln -s "$DIR/opencode/opencode.jsonc" ~/.config/opencode/opencode.jsonc

# mise follows mbx's rapid releases while the tracked wrapper keeps plain Cargo
# routed through it. setup also installs the shim used outside mise activation.
command -v mise >/dev/null
mise install mr-boxington
mise exec -- mbx setup --global
mise exec -- mbx setup --global --status

# Install the manual cleanup service, retire its old automatic timer, pull
# dotfiles hourly, and schedule weekly Nix store GC.
if [ "$(uname -s)" = Linux ] && command -v systemctl >/dev/null; then
	if systemctl --user show-environment >/dev/null 2>&1; then
		"$DIR/bin/install-worktree-clean.sh"
		systemctl --user link "$DIR/systemd/dotfiles-update.service"
		systemctl --user enable --now "$DIR/systemd/dotfiles-update.timer"
		# NixOS hosts collect through nix.gc.automatic instead.
		if [ ! -e /etc/NIXOS ] && [ -x /nix/var/nix/profiles/default/bin/nix-collect-garbage ]; then
			systemctl --user link "$DIR/systemd/nix-gc.service"
			systemctl --user enable --now "$DIR/systemd/nix-gc.timer"
		fi
	else
		echo "Skipping worktree cleanup and dotfiles update: no running systemd user manager"
	fi
fi

# macOS pulls dotfiles hourly through a LaunchAgent, the timer's counterpart.
# It is reloaded only when its definition changes, and never from inside the
# agent's own run (DOTFILES_UPDATE_AGENT), since unloading the job would kill
# this install; the running definition keeps working until a manual ./install.
if [ "$(uname -s)" = Darwin ]; then
	agent=~/Library/LaunchAgents/dev.kixelated.dotfiles-update.plist
	mkdir -p ~/Library/LaunchAgents ~/Library/Logs
	plist=$(sed "s|@HOME@|$HOME|g" "$DIR/launchd/dotfiles-update.plist")
	if [ "$plist" != "$(cat "$agent" 2>/dev/null)" ]; then
		if [ -n "${DOTFILES_UPDATE_AGENT:-}" ]; then
			echo "LaunchAgent definition changed; run ./install by hand to reload it"
		else
			launchctl bootout "gui/$(id -u)" "$agent" 2>/dev/null || true
			printf '%s\n' "$plist" >"$agent"
			launchctl bootstrap "gui/$(id -u)" "$agent"
		fi
	fi
fi

# ~/.agents/skills is Codex's user-level skills dir; ~/.codex/skills is
# deprecated and Codex-managed (.system lives there), so leave it alone.
# Skills live in .claude/skills; .agents/skills links to the same directory.
mkdir -p ~/.claude ~/.codex ~/.agents
rm -rf ~/.claude/skills ~/.agents/skills
rm -f ~/.claude/CLAUDE.md ~/.codex/AGENTS.md
ln -s "$DIR/.claude/CLAUDE.md" ~/.claude/CLAUDE.md
ln -s "$DIR/.claude/skills" ~/.claude/skills
ln -s "$DIR/.claude/CLAUDE.md" ~/.codex/AGENTS.md
ln -s "$DIR/.claude/skills" ~/.agents/skills

# Every Claude Code, Codex, and Grok session loads the checkout's direnv dev
# shell through a user-level SessionStart hook, so repositories need no hooks
# of their own. See docs/dev-shell.md.
python3 "$DIR/bin/install-dev-shell.py"

# Default model and reasoning effort for Claude Code and Codex. See
# docs/agent-defaults.md.
python3 "$DIR/bin/install-agent-defaults.py"

git submodule update --init --remote
