# Shared environment configuration for Bash and Zsh.

[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

case ":$PATH:" in
*":$HOME/.cargo/bin:"*) ;;
*) export PATH="$HOME/.cargo/bin:$PATH" ;;
esac

case ":$PATH:" in
*":$HOME/.nix-profile/bin:"*) ;;
*) export PATH="$HOME/.nix-profile/bin:$PATH" ;;
esac

case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# mbx installs a Cargo shim here; it must precede the real Cargo binary.
case ":$PATH:" in
*":$HOME/.local/share/mbx/bin:"*) ;;
*) export PATH="$HOME/.local/share/mbx/bin:$PATH" ;;
esac
