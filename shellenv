# Shared environment configuration for Bash and Zsh.

[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

case ":$PATH:" in
*":$HOME/.cargo/bin:"*) ;;
*) export PATH="$HOME/.cargo/bin:$PATH" ;;
esac

case ":$PATH:" in
*":$HOME/.nix-profile/bin:"*) ;;
*) export PATH="$HOME/.nix-profile/bin:$PATH" ;;
esac

case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Expose mise-managed global tools in non-interactive shells such as CI runners.
case ":$PATH:" in
*":$HOME/.local/share/mise/shims:"*) ;;
*) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac

# mbx installs a Cargo shim here; it must precede the real Cargo binary.
case ":$PATH:" in
*":$HOME/.local/share/mbx/bin:"*) ;;
*) export PATH="$HOME/.local/share/mbx/bin:$PATH" ;;
esac

# Claude Code caps a single Bash tool call at 10 minutes by default; long
# watches (stock polls, soak tests) should not need re-arming every 10 minutes.
export BASH_MAX_TIMEOUT_MS=3600000
