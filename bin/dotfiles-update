#!/usr/bin/env bash
# Pull this dotfiles checkout and rerun ./install until the checked-out commit
# has installed successfully. A systemd user timer (Linux) or LaunchAgent
# (macOS) runs it hourly; see docs/self-update.md. A pull that cannot
# fast-forward fails loudly.
set -euo pipefail
cd "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
git pull --ff-only --quiet
installed=$(git rev-parse --git-path dotfiles-installed)
head=$(git rev-parse HEAD)
[ "$head" = "$(cat "$installed" 2>/dev/null)" ] && exit 0
./install
echo "$head" >"$installed"
