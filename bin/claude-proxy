#!/usr/bin/env python3
"""Run the stock Claude Code binary through the CLIProxyAPI subscription gateway.

Bare `claude` is never wrapped; it keeps whatever account is logged in.
"""
import os
from pathlib import Path
import sys

CLOUD_SELECTORS = ('CLAUDE_CODE_USE_BEDROCK', 'CLAUDE_CODE_USE_VERTEX',
                   'CLAUDE_CODE_USE_FOUNDRY', 'CLAUDE_CODE_USE_ANTHROPIC_AWS')
DEFAULT_BASE_URL = 'http://127.0.0.1:8317'


def main():
    home = Path.home()
    config = home / '.config/cliproxy-proxy'
    try:
        key = (config / 'client-key').read_text().strip()
    except FileNotFoundError:
        raise SystemExit('Proxy gateway client key missing; run install-claude-proxy.py.') from None
    try:
        # Hosts without their own gateway point this at the desktop's tailnet address.
        base_url = (config / 'base-url').read_text().strip()
    except FileNotFoundError:
        base_url = DEFAULT_BASE_URL
    env = os.environ.copy()
    for name in CLOUD_SELECTORS:
        env.pop(name, None)
    env.update({
        'CLAUDE_CONFIG_DIR': str(home / '.claude-proxy'),
        'ANTHROPIC_BASE_URL': base_url,
        'ANTHROPIC_AUTH_TOKEN': key,
        'ANTHROPIC_API_KEY': '',
        'CLAUDE_CODE_OAUTH_TOKEN': '',
    })
    cli = home / '.local/bin/claude'
    if not cli.exists() or cli.resolve() == Path(__file__).resolve():
        raise SystemExit(f'Official Claude Code binary missing at {cli}; reinstall Claude Code.')
    os.execve(str(cli), [str(cli), *sys.argv[1:]], env)


if __name__ == '__main__':
    main()
