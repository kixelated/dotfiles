#!/usr/bin/env python3
"""Run the official Claude Code binary through the personal subscription hub."""
import os
from pathlib import Path
import sys

CLOUD_SELECTORS = ('CLAUDE_CODE_USE_BEDROCK', 'CLAUDE_CODE_USE_VERTEX',
                   'CLAUDE_CODE_USE_FOUNDRY', 'CLAUDE_CODE_USE_ANTHROPIC_AWS')
ROUTING = ('ANTHROPIC_BASE_URL', 'ANTHROPIC_AUTH_TOKEN', 'ANTHROPIC_API_KEY',
           'CLAUDE_CODE_OAUTH_TOKEN', *CLOUD_SELECTORS)


def main():
    home = Path.home()
    env = os.environ.copy()
    explicit_personal = Path(sys.argv[0]).name == 'claude-personal'
    if explicit_personal or not any(env.get(name) for name in ROUTING):
        for name in CLOUD_SELECTORS:
            env.pop(name, None)
        if explicit_personal or not env.get('CLAUDE_CONFIG_DIR'):
            env['CLAUDE_CONFIG_DIR'] = str(home / '.claude-personal')
        try:
            key = (home / '.config/cliproxy-personal/client-key').read_text().strip()
        except FileNotFoundError:
            raise SystemExit('Personal gateway client key missing; run install-claude-personal.py.') from None
        env.update({
            'ANTHROPIC_BASE_URL': 'http://127.0.0.1:8317',
            'ANTHROPIC_AUTH_TOKEN': key,
            'ANTHROPIC_API_KEY': '',
            'CLAUDE_CODE_OAUTH_TOKEN': '',
        })
    cli = home / '.local/bin/claude'
    if not cli.exists() or cli.resolve().name in ('claude-personal', 'claude-launcher') or cli.resolve() == Path(__file__).resolve():
        cli = home / '.local/bin/claude-native'
    if not cli.exists() or cli.resolve().name in ('claude-personal', 'claude-launcher') or cli.resolve() == Path(__file__).resolve():
        raise SystemExit('Official Claude binary missing; reinstall Claude Code and run install-claude-default.py.')
    os.execve(str(cli), [str(cli), *sys.argv[1:]], env)


if __name__ == '__main__':
    main()
